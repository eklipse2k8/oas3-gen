{
  "openapi": "3.1.0",
  "info": { "title": "Operations", "version": "1.0.0" },
  "paths": {
    "/users/{userId}/posts/{postId}/{slug}": {
      "parameters": [
        { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
        { "name": "limit", "in": "query", "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getUserPost",
        "parameters": [
          { "name": "theme", "in": "cookie", "schema": { "type": "string" } },
          { "name": "X-Trace", "in": "header", "schema": { "type": "string" } },
          { "name": "content-type", "in": "header", "schema": { "type": "string" } },
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "The post",
            "headers": {
              "X-Rate-Limit": { "required": true, "schema": { "type": "integer", "format": "int32" } },
              "Content-Type": { "schema": { "type": "string" } },
              "x-mode": { "schema": { "type": "string", "enum": ["fast", "slow"] } },
              "x-trace": { "content": { "text/plain": { "schema": { "type": "string" } } } }
            },
            "content": { "application/json": { "schema": { "type": "string" } } }
          },
          "404": { "description": "Missing" }
        }
      }
    },
    "/ping": {
      "get": {
        "operationId": "ping",
        "responses": { "204": { "description": "No content" }, "default": { "description": "Anything else" } }
      }
    },
    "/items": {
      "get": {
        "operationId": "getItem",
        "responses": {
          "200": { "description": "The item", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/forms": {
      "post": {
        "operationId": "submitForm",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UploadForm" },
              "encoding": {
                "listed": {
                  "contentType": "image/png, image/jpeg",
                  "headers": {
                    "X-Signature": { "required": true, "schema": { "type": "string" } },
                    "X-Trace": { "schema": { "type": "string" } },
                    "Content-Type": { "required": true, "schema": { "type": "string" } }
                  }
                },
                "missing": { "contentType": "text/plain" },
                "wildcard": { "contentType": "image/*, application/*" },
                "invalid": { "contentType": "not a media type" },
                "plain": { "contentType": "text/plain" }
              }
            }
          }
        },
        "responses": { "204": { "description": "Accepted" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": { "type": "object", "properties": { "code": { "type": "integer" } } },
      "UploadForm": {
        "type": "object",
        "properties": {
          "listed": { "type": "string", "format": "binary" },
          "wildcard": { "type": "string", "format": "binary" },
          "invalid": { "type": "string" },
          "plain": { "type": "string" }
        }
      }
    }
  }
}
