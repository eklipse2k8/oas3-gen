                { "$ref": "#/components/schemas/BetaMessageStartEvent" },
                { "$ref": "#/components/schemas/BetaMessageStopEvent" }
              ]
            }
          },
          "items": {
            "type": "array",
            "items": { "anyOf": [{ "$ref": "#/components/schemas/TypeA" }, { "$ref": "#/components/schemas/TypeB" }] }
          },
          "fluff": { "properties": { "key": { "type": "string" } } }
        }
      },
      "Matrix": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
      "Untyped": { "type": "array" },
      "NoValues": { "type": "string", "enum": [] },
      "NullableLevel": { "anyOf": [{ "type": "string", "enum": ["low", "high"] }, { "type": "null" }] },
      "Mixes": {
        "type": "array",
        "items": { "oneOf": [{ "$ref": "#/components/schemas/TypeA" }, { "$ref": "#/components/schemas/LoafNugget" }] }
      },
      "MaybeMixes": {
        "type": ["array", "null"],
        "items": { "oneOf": [{ "$ref": "#/components/schemas/TypeB" }, { "$ref": "#/components/schemas/Loaf" }] }
