{
  "openapi": "3.1.0",
  "info": { "title": "Names", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "my-test-enum": { "oneOf": [{ "type": "string", "const": "option-a" }, { "type": "string", "const": "option-b" }] },
      "my_test_union": { "oneOf": [{ "type": "object", "properties": { "data_field": { "type": "string" } } }] },
      "AlreadyPascal": { "oneOf": [{ "type": "string", "const": "OptionA" }, { "type": "string", "const": "OptionB" }] },
      "LoafNugget": { "type": "object", "properties": { "crumb": { "type": "string" } } },
      "Loaf": { "type": "object", "properties": { "nugget": { "type": "object", "properties": { "tag_id": { "type": "string" } } } } },
      "BetaResponseCharLocationCitation": { "type": "object", "properties": { "location": { "type": "string" } } },
      "BetaResponseUrlCitation": { "type": "object", "properties": { "url": { "type": "string" } } },
      "BetaMessageStartEvent": { "type": "object", "properties": { "started": { "type": "string" } } },
      "BetaMessageStopEvent": { "type": "object", "properties": { "stopped": { "type": "string" } } },
      "TypeA": { "type": "object", "properties": { "field_a": { "type": "string" } } },
      "TypeB": { "type": "object", "properties": { "field_b": { "type": "integer" } } },
      "Holder": {
        "type": "object",
        "properties": {
          "citation": {
            "oneOf": [
              { "$ref": "#/components/schemas/BetaResponseCharLocationCitation" },
              { "$ref": "#/components/schemas/BetaResponseUrlCitation" }
            ]
          },
          "events": {
