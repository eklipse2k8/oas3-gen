{
  "openapi": "3.1.0",
  "info": { "title": "Response names", "version": "1.0.0" },
  "paths": {
    "/users": {
      "get": {
        "operationId": "getUser",
        "responses": {
          "200": { "$ref": "#/components/responses/User" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "404": { "$ref": "#/components/responses/BasicError" }
        }
      }
    },
    "/teams": {
      "get": {
        "operationId": "getTeam",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WithHeaders" } } } },
          "404": { "$ref": "#/components/responses/BasicError" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "ok",
            "headers": { "Link": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/cats": {
      "get": {
        "operationId": "listCats",
        "responses": {
          "200": {
            "description": "ok",
            "headers": { "Link": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    },
    "/pets/count": {
      "get": {
        "operationId": "countPets",
        "responses": {
          "200": {
            "description": "ok",
            "headers": { "Link": { "schema": { "type": "integer" } } },
            "content": { "application/json": { "schema": { "type": "integer" } } }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "User": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
      "BasicError": { "description": "missing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BasicError" } } } },
      "ValidationError": { "description": "invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } } }
    },
    "schemas": {
      "ApiResponse": { "type": "object", "properties": { "code": { "type": "integer" } } },
      "WithHeaders": { "type": "object", "properties": { "name": { "type": "string" } } },
      "User": { "type": "object", "properties": { "name": { "type": "string" } } },
      "BasicError": { "type": "object", "properties": { "message": { "type": "string" } } },
      "ValidationError": { "type": "object", "properties": { "errors": { "type": "array", "items": { "type": "string" } } } }
    }
  }
}
